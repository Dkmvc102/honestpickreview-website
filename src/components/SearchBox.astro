---
---

<div class="search-box" id="search-box">
  <div class="search-box__field">
    <svg class="search-box__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
      <path d="M21 21L16.65 16.65" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <input
      type="text"
      id="search-box-input"
      class="search-box__input"
      placeholder="Search product name…"
      autocomplete="off"
      aria-label="Search product name"
      aria-expanded="false"
      aria-controls="search-box-results"
      role="combobox"
    />
    <button type="button" id="search-box-clear" class="search-box__clear" aria-label="Clear search" hidden>
      &times;
    </button>
  </div>

  <div id="search-box-results" class="search-box__results" role="listbox" hidden></div>
</div>

<style>
  .search-box {
    position: relative;
    width: 100%;
    max-width: 260px;
  }

  .search-box__field {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 7px 10px;
    transition: border-color 0.15s ease;
  }

  .search-box__field:focus-within {
    border-color: var(--color-primary);
  }

  .search-box__icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .search-box__input {
    border: none;
    background: none;
    outline: none;
    font-size: 0.88rem;
    font-family: var(--font-sans);
    color: var(--color-text);
    width: 100%;
    min-width: 0;
  }

  .search-box__input::placeholder {
    color: var(--color-text-muted);
  }

  .search-box__clear {
    border: none;
    background: none;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0 2px;
    flex-shrink: 0;
  }

  .search-box__clear:hover {
    color: var(--color-text);
  }

  .search-box__results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card-hover);
    max-height: 380px;
    overflow-y: auto;
    z-index: 50;
    min-width: 280px;
  }

  .search-box__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .search-box__item:last-child {
    border-bottom: none;
  }

  .search-box__item:hover,
  .search-box__item.is-active {
    background: var(--color-surface);
  }

  .search-box__item img {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    background: var(--color-surface);
  }

  .search-box__item-text {
    min-width: 0;
  }

  .search-box__item-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-box__item-meta {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .search-box__empty {
    padding: 16px 12px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 760px) {
    .search-box {
      max-width: none;
      order: 3;
      flex-basis: 100%;
    }
  }
</style>

<script>
  interface SearchItem {
    slug: string;
    url: string;
    title: string;
    brand: string;
    image: string;
    imageAlt: string;
    rating: number;
    priceRange: string;
  }

  const box = document.getElementById('search-box') as HTMLElement | null;
  const input = document.getElementById('search-box-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('search-box-clear') as HTMLButtonElement | null;
  const results = document.getElementById('search-box-results') as HTMLElement | null;

  let items: SearchItem[] = [];
  let loaded = false;
  let activeIndex = -1;

  async function ensureLoaded() {
    if (loaded) return;
    try {
      const res = await fetch('/search-index.json');
      items = await res.json();
      loaded = true;
    } catch {
      items = [];
    }
  }

  function closeResults() {
    if (!results) return;
    results.hidden = true;
    results.innerHTML = '';
    activeIndex = -1;
    input?.setAttribute('aria-expanded', 'false');
  }

  function render(list: SearchItem[]) {
    if (!results) return;
    activeIndex = -1;

    if (list.length === 0) {
      results.innerHTML = '<div class="search-box__empty">No products found</div>';
      results.hidden = false;
      input?.setAttribute('aria-expanded', 'true');
      return;
    }

    results.innerHTML = list
      .slice(0, 8)
      .map(
        (item, i) => `
        <a href="${item.url}" class="search-box__item" role="option" data-index="${i}">
          <img src="${item.image}" alt="" loading="lazy" />
          <span class="search-box__item-text">
            <span class="search-box__item-title">${escapeHtml(item.title)}</span>
            <span class="search-box__item-meta">${escapeHtml(item.brand)} · ${escapeHtml(item.priceRange)}</span>
          </span>
        </a>`
      )
      .join('');

    results.hidden = false;
    input?.setAttribute('aria-expanded', 'true');
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function search(query: string) {
    const q = query.trim().toLowerCase();
    if (clearBtn) clearBtn.hidden = q.length === 0;

    if (q.length === 0) {
      closeResults();
      return;
    }

    const matches = items.filter(
      (item) =>
        item.title.toLowerCase().includes(q) || item.brand.toLowerCase().includes(q)
    );

    render(matches);
  }

  input?.addEventListener('focus', async () => {
    await ensureLoaded();
    if (input.value.trim()) search(input.value);
  });

  input?.addEventListener('input', async () => {
    await ensureLoaded();
    search(input.value);
  });

  input?.addEventListener('keydown', (e) => {
    const optionEls = results?.querySelectorAll<HTMLAnchorElement>('.search-box__item');
    if (!optionEls || optionEls.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, optionEls.length - 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
    } else if (e.key === 'Enter') {
      if (activeIndex >= 0) {
        e.preventDefault();
        optionEls[activeIndex].click();
      }
      return;
    } else if (e.key === 'Escape') {
      closeResults();
      input.blur();
      return;
    } else {
      return;
    }

    optionEls.forEach((el, i) => el.classList.toggle('is-active', i === activeIndex));
    optionEls[activeIndex]?.scrollIntoView({ block: 'nearest' });
  });

  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    clearBtn.hidden = true;
    closeResults();
    input.focus();
  });

  document.addEventListener('click', (e) => {
    if (box && !box.contains(e.target as Node)) {
      closeResults();
    }
  });
</script>
